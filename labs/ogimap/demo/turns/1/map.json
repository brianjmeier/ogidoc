   "status": "built",
   "ways": [
    {
     "pseudo": [
      "6 × random char from ALPHABET",
      "store.save refuses a taken code",
      "shorten retries makeCode until save succeeds",
      "→ code, never one already taken"
     ]
    },
    {
     "pseudo": [
      "n = next counter value",
      "code = n in base-32 over ALPHABET",
      "→ code, unique by construction (short but guessable)"
     ]
    }
   ]
