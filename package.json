{
  "name": "ogidoc",
  "version": "0.1.0",
  "description": "Build software by taking turns with an agent on one pseudocode file. The real code is built underneath.",
  "homepage": "https://ogidoc.brianmeier.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianjmeier/ogidoc.git"
  },
  "bugs": "https://github.com/brianjmeier/ogidoc/issues",
  "type": "module",
  "bin": {
    "ogidoc": "dist/bin/ogidoc.js"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "dist/web",
    "agent",
    "demo",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node bin/ogidoc.ts",
    "build": "node -e \"for (const d of ['dist/bin', 'dist/src']) require('fs').rmSync(d, { recursive: true, force: true })\" && vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "site": "vite -c vite.site.config.ts",
    "build:site": "vite build -c vite.site.config.ts",
    "prepare": "npm run build",
    "typecheck": "tsc -p . && tsc -p app && tsc -p site",
    "demo": "node bin/ogidoc.ts --demo",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node test/e2e.ts",
    "test:site": "node test/site-e2e.ts",
    "test:real": "node test/real-agent.ts",
    "record": "node scripts/record-demo.ts"
  },
  "license": "MIT",
  "keywords": [
    "agent",
    "claude-code",
    "pi",
    "pseudocode",
    "tdd",
    "pair-programming"
  ],
  "devDependencies": {
    "@kobalte/core": "0.13.14",
    "@types/node": "22.20.5",
    "playwright": "1.63.0",
    "solid-js": "1.9.17",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14"
  }
}
