{
  "name": "underpaint",
  "version": "0.1.0",
  "description": "Build software by taking turns with an agent on one pseudocode file. The real code is built underneath.",
  "type": "module",
  "bin": {
    "underpaint": "dist/bin/underpaint.js"
  },
  "files": [
    "dist",
    "agent",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node bin/underpaint.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "site": "vite -c vite.site.config.ts",
    "build:site": "vite build -c vite.site.config.ts",
    "prepare": "npm run build",
    "typecheck": "tsc -p . && tsc -p app && tsc -p site",
    "demo": "node bin/underpaint.ts demo.plan --agent mock --script test/fixtures/weekly.json --no-commit",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node test/e2e.ts",
    "test:site": "node test/site-e2e.ts",
    "test:real": "node test/real-agent.ts"
  },
  "license": "MIT",
  "keywords": [
    "agent",
    "claude-code",
    "pi",
    "pseudocode",
    "tdd",
    "pair-programming"
  ],
  "dependencies": {
    "@kobalte/core": "0.13.14",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14"
  }
}
